# 공개 사이트 주소 (canonical, sitemap, JSON-LD 기준)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres (필수). 콘솔 Connect → Pooled connection 문자열.
# 서버 전용이다. NEXT_PUBLIC_ 을 붙이지 않는다.
DATABASE_URL=

# AI 분석·생성 (M2)
ANTHROPIC_API_KEY=

# 검수 큐 (/admin). 비어 있으면 관리 라우트는 404.
# 값이 있으면 쿠키 세션(로그인)이 있어야 /admin 에 접근한다.
ADMIN_SECRET=
