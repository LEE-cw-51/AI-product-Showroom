{
  "name": "showroom-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "validate:content": "node scripts/validate-content.mts",
    "test:qa": "node --test lib/ai/qa.test.mts",
    "pipeline": "node --env-file-if-exists=.env.local --import ./scripts/resolve-alias.mjs scripts/pipeline.mts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mts",
    "db:seed": "node --env-file-if-exists=.env.local --import ./scripts/resolve-alias.mjs scripts/seed-db.mts",
    "test": "node --test lib/ai/qa.test.mts lib/events/referrer.test.mts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.59",
    "@neondatabase/serverless": "1.1.0",
    "ai": "^7.0.109",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
